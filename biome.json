{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "bracketSameLine": true
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "useVueValidTemplateRoot": "off",
        "noUnusedImports": "off",
        "noUnusedFunctionParameters": "off",
        "useParseIntRadix": "off"
      },
      "complexity": {
        "noUselessEscapeInRegex": "off",
        "noUselessStringRaw": "off",
        "useOptionalChain": "off",
        "useDateNow": "off",
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useVueMultiWordComponentNames": "off",
        "useTemplate": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        "noExplicitAny": "off",
        "noRedeclare": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noConfusingVoidType": "off",
        "noGlobalIsNan": "off",
        "noIrregularWhitespace": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{js,mjs,cjs,ts,tsx,vue}"],
      "javascript": {
        "globals": ["exports", "location"]
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ":PACKAGE:", ":ALIAS:", ":PATH:"]
          }
        }
      }
    }
  }
}
